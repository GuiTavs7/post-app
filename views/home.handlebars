<div class="page-shell">
    <header class="page-header">
        <div>
            <p class="eyebrow">Blog pessoal</p>
            <h1>📝 Lista de Posts</h1>
            <p class="page-subtitle">Organize suas ideias com uma interface mais elegante e profissional.</p>
        </div>

        <a href="/cad" class="btn btn-primary">
            + Nova postagem
        </a>
    </header>

    <!-- Estrutura de repetição para exibir os posts cadastrados no banco de dados -->

    {{#each posts}}

    <article class="card">
        <div class="card-top">
            <span class="post-date">Publicado em: {{createdAt}}</span>
            <span class="post-badge">Publicação</span>
        </div>

        <h2>{{titulo}}</h2>

        <p>{{conteudo}}</p>

        <img src="{{imagem}}" alt="Imagem do post" class="post-image">

        <div class="card-actions">
            <a href="/deletar/{{id}}" class="btn btn-danger">
                Deletar
            </a>
        </div>
    </article>

    {{else}}

    <div class="empty-state">
        <h2>Nenhuma postagem ainda</h2>
        <p>Ainda não existem postagens cadastradas. Crie a primeira para começar.</p>
        <a href="/cad" class="btn btn-primary">Criar primeira postagem</a>
    </div>

    {{/each}}
</div>