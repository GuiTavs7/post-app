<h1>📝 Lista de Posts</h1>

<a href="/cad" class="btn">
    + Nova postagem
</a>

<!-- Estrutura de repetição para exibir os posts cadastrados no banco de dados -->

{{#each posts}}

<div class="card">

    <small>
        Publicado em: {{createdAt}}
    </small>

    <h2>{{titulo}}</h2>

    <p>{{conteudo}}</p>

    <img src="/uploads/{{imagem}}" alt="Imagem do post" class="post-image">

    <a href="/deletar/{{id}}" class="btn delete">
        Deletar
    </a>

</div>

{{else}}

<p class="sem-post">
    Ainda não existem postagens cadastradas.
</p>

{{/each}}