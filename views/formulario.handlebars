<form action="/add" method="POST">
    <p>Título:</p>
    <input type="text" name="titulo">
    <p>Conteúdo:</p>
    <textarea name="conteudo"></textarea>
    <button type="submit">Cadastrar postagem</button>
</form>

<!-- method = forma pela qual o form será enviado para o backend, podendo ser GET ou POST -->

<!-- GET = envia dados pela url, podendo ser visualizado na barra de endereços do navegador, e tem limite de caracteres para envio de dados -->

<!-- POST = envia dados de forma oculta, não sendo visualizado na barra de endereços do navegador, e não tem limite de caracteres para envio de dados -->

<!-- action = caminho para onde os dados do form serão enviados, podendo ser uma rota do backend ou um link externo -->